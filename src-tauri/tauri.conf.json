{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LOAM",
  "version": "1.8.0",
  "identifier": "app.loam.launcher",
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LOAM \u2014 Your worlds, ready.",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#F4F3EE",
        "devtools": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: https://textures.minecraft.net https://cdn.modrinth.com https://media.forgecdn.net; font-src 'self'; frame-src https://www.youtube-nocookie.com; connect-src 'self' ipc: http://ipc.localhost https://textures.minecraft.net data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "LOAM",
    "copyright": "Copyright 2026 LOAM. All rights reserved.",
    "homepage": "https://loamlauncher.app",
    "shortDescription": "Your worlds, ready.",
    "longDescription": "LOAM is a launcher for Minecraft: Java Edition. It installs and starts Vanilla, Fabric and Quilt games.",
    "category": "Game",
    "windows": {
      "nsis": {
        "template": "installer/loam.nsi",
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp"
      }
    }
  }
}
