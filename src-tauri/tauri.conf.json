{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LOAM",
  "version": "0.1.0",
  "identifier": "app.loam.launcher",
  "plugins": { "updater": { "pubkey": "", "requireSignedVersion": true } },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LOAM — Your worlds, ready.",
        "width": 1120,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#F4F3EE"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Your worlds, ready.",
    "category": "Game",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp"
      }
    }
  }
}
